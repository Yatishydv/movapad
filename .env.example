# =============================================================================
# MovaPad — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================================

# ── Signaling Server ──
SIGNALING_PORT=8080
SIGNALING_HOST=0.0.0.0

# ── Database ──
DATABASE_URL=postgresql://movapad:password@localhost:5432/movapad
DATABASE_POOL_SIZE=10

# ── TURN Server ──
TURN_SERVER_URL=turn:your-turn-server.example.com:3478
TURN_SECRET=your-turn-shared-secret-change-this
TURN_CREDENTIAL_TTL=3600

# ── STUN Server ──
STUN_SERVER_URL=stun:stun.l.google.com:19302

# ── Security ──
PAIRING_TOKEN_TTL_SECONDS=300
SESSION_TOKEN_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ──
LOG_LEVEL=info

# ── Environment ──
NODE_ENV=development
